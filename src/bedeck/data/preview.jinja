{#
A preview of a theme, printed by `bedeck preview`: mock-ups of a prompt, a file
listing, git and tabs, in the theme's colors. This is rich's markup:
[STYLE]text[/] styles the text, where a style is e.g. a color, "on" a
background color, and bold. A literal [ is written \[.
#}
{% macro swatch(name, color, width=15) %}[{{ color }}]████[/] {{ name.ljust(width) }}[{{ ui.dim }}]{{ color }}[/]{% endmacro %}
{# Permissions as eza shows them: the kind of file, then each letter in its color (bold for the owner's, and the
   owner's x underlined on a file) and each dash dimmed. #}
{% macro perms(text) %}{% for ch in text %}{% if loop.first %}[{{ {'d': 'bold ' ~ file.directory, 'l': file.symlink, '|': file.special}.get(ch, ui.text) }}]{{ ch }}[/]{% elif ch == '-' %}[{{ ui.dim }}]-[/]{% else %}[{{ 'bold ' if loop.index <= 4 else '' }}{{ 'underline ' if loop.index == 4 and text[0] in '.|' else '' }}{{ {'r': permissions.read, 'w': permissions.write, 'x': permissions.execute}[ch] }}]{{ ch }}[/]{% endif %}{% endfor %}{% endmacro %}
[bold]ANSI colors[/]
{% for name in ansi[:8] %}
  {{ swatch(name, colors[name]) }}    {{ swatch('bright_' ~ name, colors['bright_' ~ name]) }}
{% endfor %}

[bold]Accents[/]
{# The theme's other colors: those with a bright variant beside it, then the
   rest two to a line. Colors that are also a background or text step are left
   to the next section. #}
{% set steps = [] %}
{% for suffix in ['_hard', '0', '1', '2', '3', '4'] %}
{% set _ = steps.extend([colors['bg' ~ suffix], colors['fg' ~ suffix]]) %}
{% endfor %}
{% set paired, single = [], [] %}
{% for name in colors if name not in ansi and name[:2] not in ('bg', 'fg') and not name.startswith('bright_') and colors[name] not in steps %}
{% set _ = (paired if 'bright_' ~ name in colors else single).append(name) %}
{% endfor %}
{% for name in paired %}
  {{ swatch(name, colors[name]) }}    {{ swatch('bright_' ~ name, colors['bright_' ~ name]) }}
{% endfor %}
{% for pair in single | batch(2) %}
  {{ swatch(pair[0], colors[pair[0]]) }}{% if pair | length > 1 %}    {{ swatch(pair[1], colors[pair[1]]) }}{% endif %}

{% endfor %}

[bold]Background and foreground[/]
{% for suffix in ['_hard', '0', '1', '2', '3', '4'] %}
  {{ swatch('bg' ~ suffix, colors['bg' ~ suffix]) }}    {{ swatch('fg' ~ suffix, colors['fg' ~ suffix]) }}
{% endfor %}

[bold]Prompt[/]
{# The host, then the icons of the watched repos needing attention, then the
   directory and its branch, separated by single carets and ended by a double
   one. #}
  [bold {{ ui.highlight }}]host[/] › [bold {{ git.pending }}]󰒓 󰠮[/] › [bold {{ file.directory }}]~/projects/bedeck[/] on [{{ git.branch }}] [bold]main ✓*?[/][/] » [{{ ui.cursor }}]▏[/]

[bold]Files[/]
  {{ perms('drwxr-xr-x') }} [{{ ui.dim }}]   -[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 8 Oct 10:12[/] [{{ ui.dim }}]--[/] [bold {{ file.directory }}]src[/]
  {{ perms('lrwxrwxrwx') }} [{{ ui.dim }}]   -[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 8 Oct 10:12[/] [{{ ui.dim }}]--[/] [{{ file.symlink }}]current[/] -> [bold {{ file.directory }}]src[/]
  {{ perms('.rwxr-xr-x') }} [{{ file.size }}]1.2k[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 8 Oct 10:12[/] [{{ ui.dim }}]-[/][{{ git.modified }}]M[/] [bold {{ file.executable }}]build[/]
  {{ perms('.rw-r--r--') }} [{{ file.size }}] 840[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 8 Oct 10:12[/] [{{ ui.dim }}]--[/] [{{ file.script }}]setup.sh[/]
  {{ perms('.rw-r--r--') }} [{{ file.size }}]2.1k[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 8 Oct 10:12[/] [{{ git.added }}]N[/][{{ ui.dim }}]-[/] [{{ file.plain }}]README.md[/]
  {{ perms('.rw-r--r--') }} [{{ file.size }}] 14M[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 7 Oct 18:40[/] [{{ ui.dim }}]--[/] [{{ file.archive }}]backup.tar.gz[/]
  {{ perms('.rw-r--r--') }} [{{ file.size }}]3.4M[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 7 Oct 18:40[/] [{{ ui.dim }}]--[/] [{{ file.media }}]photo.png[/]
  {{ perms('.rw-r--r--') }} [{{ file.size }}]220k[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 7 Oct 18:40[/] [{{ ui.dim }}]--[/] [{{ file.document }}]report.pdf[/]
  {{ perms('.rw-r--r--') }} [{{ file.size }}] 48k[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 7 Oct 18:40[/] [{{ ui.dim }}]--[/] [{{ file.compiled }}]main.o[/]
  {{ perms('.rw-r--r--') }} [{{ file.size }}]2.0k[/] [bold {{ ui.highlight }}]user[/] [{{ ui.dim }}] 6 Oct 09:03[/] [{{ ui.dim }}]-[/][{{ git.deleted }}]D[/] [{{ file.temp }}]notes.txt~[/]
  {{ perms('|rw-r--r--') }} [{{ ui.dim }}]   -[/] [{{ ui.alert }}]root[/] [{{ ui.dim }}] 6 Oct 09:03[/] [{{ ui.dim }}]--[/] [underline {{ file.special }}]pipe[/]

[bold]Git status[/]
  [{{ git.added }}]A [/] src/added.py
  [{{ git.added }}]M [/] src/staged.py
   [{{ git.modified }}]M[/] src/changed.py
  [{{ git.untracked }}]??[/] scratch.txt

[bold]Diff[/]
  [on {{ diff.deleted }}]{{ '- a line that was deleted'.ljust(44) }}[/]
  [on {{ diff.added }}]{{ '+ a line that was added'.ljust(44) }}[/]
  [on {{ diff.changed }}]{{ '~ a line that was changed'.ljust(44) }}[/]

[bold]Multiplexer[/]
{# The status bar as tmux's status.conf draws it: the accent blocks at either
   end, then tabs that each end in an angled separator colored from the tab into
   whatever follows it, except between two inactive tabs, where it's a thin one
   in the bar's color. The right block's items are split the same way. A bell in
   a tab is the tab's own color. #}
{% set sep, thin = '\ue0b0', '\ue0b1' %}
{% set a, a_text, bar = ui.accent_bg, ui.accent_fg, ui.panel %}
{% set on, on_text = ui.active_bg, ui.active_fg %}
{% set off, off_text = ui.inactive_bg, ui.inactive_fg %}
  [{{ a_text }} on {{ a }}] 󰞷 [/][{{ a }} on {{ on }}]{{ sep }}[/][bold {{ on_text }} on {{ on }}] 1:nvim [/][{{ on }} on {{ off }}]{{ sep }}[/][{{ off_text }} on {{ off }}] 2:zsh [/][{{ bar }} on {{ off }}]{{ thin }}[/][{{ off_text }} on {{ off }}] 󰂚 3:logs [/][{{ off }} on {{ bar }}]{{ sep }}[/][on {{ bar }}]{{ ' ' * 12 }}[/][bold {{ bar }} on {{ a }}]{{ sep }}[/][bold {{ a_text }} on {{ a }}] 󰂚 [/][bold {{ bar }} on {{ a }}]{{ thin }}[/][bold {{ a_text }} on {{ a }}] 󰆍 main [/][bold {{ bar }} on {{ a }}]{{ thin }}[/][bold {{ a_text }} on {{ a }}] {{ '\uf17c' }} host [/]

[bold]Syntax[/]
  [bold {{ syntax.command }}]grep[/] [{{ syntax.variable }}]-rn[/] [{{ syntax.string }}]'todo'[/] [{{ syntax.operator }}]|[/] [{{ syntax.builtin }}]echo[/] [{{ syntax.variable }}]"$HOME"[/] [{{ syntax.operator }}]&&[/] [{{ syntax.keyword }}]if[/] [bold {{ syntax.error }}]nosuchcmd[/] [{{ syntax.comment }}]# a comment[/]

[bold]Completion[/]
{# zsh's completion menu, as .zshrc formats it: each group's description is
   bold, the items are in their dircolors colors, and the selected item is bold
   on the menu's background with no color of its own. Messages and warnings
   start with a space. #}
  [bold {{ ui.dim }}]-- local directory --[/]
  [bold {{ file.directory }}]output/[/]  [bold {{ ui.current_fg }} on {{ ui.current_bg }}]src/[/]  [bold {{ file.directory }}]themes/[/]
  [bold {{ ui.dim }}]-- file --[/]
  [{{ file.plain }}]README.md[/]  [{{ file.plain }}]pyproject.toml[/]  [{{ file.plain }}]uv.lock[/]
   [{{ diagnostics.info }}]-- a message --[/]   [{{ diagnostics.warning }}]-- no matches found --[/]

[bold]Picker[/]
{# fzf, in its reverse layout (the prompt at the top, as in tmux's pickers),
   with the first line marked and the cursor on the one below it. The prompt and
   the query, which is bold, come first, then the info and a separator, then the
   list. Lines start with the gutter; the current line is bold, with the pointer,
   and filled to its end; a marked line has the marker in place of the space
   after the gutter. #}
{% set m, gutter = picker.match, picker.gutter %}
  [{{ picker.prompt }}] {{ '\uf105' }} [/][bold]src[/]
  [{{ picker.info }}]  4/6 (1)[/] [{{ picker.separator }}]{{ '─' * 34 }}[/]
  [{{ gutter }}]▌[/][{{ picker.marker }}]┃[/][{{ m }}]src[/]/bedeck/cli.py
  [bold {{ m }} on {{ ui.current_bg }}]▌[/][bold {{ ui.current_fg }} on {{ ui.current_bg }}] [{{ m }}]src[/]{{ '/bedeck/build.py'.ljust(40) }}[/]
  [{{ gutter }}]▌[/] [{{ m }}]src[/]/bedeck/theme.py
  [{{ gutter }}]▌[/] docs/[{{ m }}]s[/]ou[{{ m }}]rc[/]es.md

[bold]Text[/]
{# Selected text keeps its own colors, so the selection is shown behind text in a
   few colors. #}
  [on {{ ui.selection_bg }}] a selection keeps [{{ syntax.string }}]its[/] [{{ syntax.keyword }}]own[/] [{{ syntax.variable }}]colors[/] [/]
  [{{ search.text }} on {{ search.match }}] a match [/] [{{ search.text }} on {{ search.current }}] the current match [/]