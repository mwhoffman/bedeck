{#
A preview of a theme, printed by `bedeck preview`: mock-ups of a prompt, a file
listing, git and tabs, in the theme's colors. This is rich's markup:
[STYLE]text[/] styles the text, where a style is e.g. a color, "on" a
background color, and bold. A literal [ is written \[.
#}
{% macro swatch(name, color, width=15) %}[{{ color }}]████[/] {{ name.ljust(width) }}[{{ ui.text_dim }}]{{ color }}[/]{% endmacro %}
{# Permissions as eza shows them: the kind of file, then each letter in its color (bold for the owner's, and the
   owner's x underlined on a file) and each dash dimmed. #}
{% macro perms(text) %}{% for ch in text %}{% if loop.first %}[{{ {'d': 'bold ' ~ file.directory, 'l': file.symlink, '|': file.special}.get(ch, ui.text) }}]{{ ch }}[/]{% elif ch == '-' %}[{{ ui.text_dim }}]-[/]{% else %}[{{ 'bold ' if loop.index <= 4 else '' }}{{ 'underline ' if loop.index == 4 and text[0] in '.|' else '' }}{{ {'r': permissions.read, 'w': permissions.write, 'x': permissions.execute}[ch] }}]{{ ch }}[/]{% endif %}{% endfor %}{% endmacro %}
[bold]ANSI colors[/]
{% for name in ansi[:8] %}
  {{ swatch(name, colors[name]) }}    {{ swatch('bright_' ~ name, colors['bright_' ~ name]) }}
{% endfor %}

[bold]Accents[/]
{% for name in colors if name not in ansi and name[:2] not in ('bg', 'fg') and not name.startswith('bright_') %}
  {{ swatch(name, colors[name]) }}    {{ swatch('bright_' ~ name, colors['bright_' ~ name]) }}
{% endfor %}

[bold]Background and foreground[/]
{% for suffix in ['_hard', '0', '1', '2', '3', '4'] %}
  {{ swatch('bg' ~ suffix, colors['bg' ~ suffix]) }}    {{ swatch('fg' ~ suffix, colors['fg' ~ suffix]) }}
{% endfor %}

