{#
zsh's theme colors, which .zshrc sources: the colors of the prompt, of
completion (messages and the menu), of zle's highlights and of the
syntax-highlighting, autosuggestions and vi-mode plugins.
#}
# zsh theme colors, sourced by .zshrc and used by it and by prompt.zsh. The
# values are colors as given to the %F{...} prompt escape, i.e. a name (e.g.
# blue), a number (e.g. 11) or a hex color (e.g. #83a598), quoted so that a hex
# color isn't read as a comment.

typeset -gA THEME_COLORS=(
  # The host, directory and git branch in the prompt, and the icons of repos
  # needing attention.
  host '{{ ui.bright_highlight | zsh }}'
  directory '{{ file.directory | zsh }}'
  branch '{{ git.branch | zsh }}'
  repos '{{ git.pending | zsh }}'

  # The descriptions (e.g. of completion groups), messages and warnings shown
  # when completing.
  completion_description '{{ messages.descriptions | zsh }}'
  completion_message '{{ messages.messages | zsh }}'
  completion_warning '{{ messages.warnings | zsh }}'
)

# Extra list-colors entries for completion menus, appended after $LS_COLORS:
# the selected item ("ma") is bold, on the menu's selected background.
typeset -ga THEME_LIST_COLORS=('ma=1;{{ ui.menu_selected | sgr("bg") }}')

# zle's own highlights: the region (outside of vi visual mode), incremental
# search (the text on the match color), and no highlighting of pasted text.
typeset -ga zle_highlight=(
  region:bg={{ ui.region | zsh }}
  isearch:fg={{ search.text | zsh }},bg={{ search.match | zsh }}
  paste:none
  suffix:bold
)

# zsh-syntax-highlighting styles. The plugin only fills in styles that aren't
# set, so these are set before it's sourced. Its default for comments is bold
# black, which is the background.
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES+=(
  # Commands, which are bold (which is what tells them apart from strings), and
  # builtins (echo, cd, ...).
  arg0 fg={{ syntax.command | zsh }},bold
  precommand fg={{ syntax.command | zsh }},bold,underline
  suffix-alias fg={{ syntax.command | zsh }},bold,underline
  autodirectory fg={{ syntax.command | zsh }},bold,underline
  builtin fg={{ syntax.builtin | zsh }}

  # Keywords (if, for, ...), and unknown commands.
  reserved-word fg={{ syntax.keyword | zsh }}
  unknown-token fg={{ syntax.error | zsh }},bold

  # Strings, with expansions inside them like variables.
  single-quoted-argument fg={{ syntax.string | zsh }}
  double-quoted-argument fg={{ syntax.string | zsh }}
  dollar-quoted-argument fg={{ syntax.string | zsh }}
  dollar-double-quoted-argument fg={{ syntax.variable | zsh }}
  back-double-quoted-argument fg={{ syntax.variable | zsh }}
  assign fg={{ syntax.variable | zsh }}

  # Operators, separators (|, &&, ;) and special syntax.
  globbing fg={{ syntax.operator | zsh }}
  history-expansion fg={{ syntax.operator | zsh }}
  redirection fg={{ syntax.operator | zsh }}
  commandseparator fg={{ syntax.operator | zsh }}
  command-substitution-delimiter fg={{ syntax.operator | zsh }}
  process-substitution-delimiter fg={{ syntax.operator | zsh }}
  back-quoted-argument-delimiter fg={{ syntax.operator | zsh }}

  # Options like variables, and comments. Existing paths are only underlined, in
  # the normal text color, since the plugin can't tell directories from files
  # (so a color like dircolors' would often be wrong).
  single-hyphen-option fg={{ syntax.variable | zsh }}
  double-hyphen-option fg={{ syntax.variable | zsh }}
  path underline
  comment fg={{ syntax.comment | zsh }}
)

# zsh-autosuggestions: suggestions like comments.
typeset -g ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{ syntax.comment | zsh }}'

# zsh-vi-mode: the visual mode selection, like the region. These must be set
# before the plugin is sourced.
typeset -g ZVM_VI_HIGHLIGHT_BACKGROUND='{{ ui.region | zsh }}'
typeset -g ZVM_VI_HIGHLIGHT_FOREGROUND='{{ ui.text | zsh }}'
