{#
polybar's colors, which its config.ini includes as its colors section.
#}
; Generated by `bedeck build`.
; polybar colors, included by config.ini.

[colors]
background = {{ ui.background }}
background-alt = {{ chrome.active }}
foreground = {{ ui.text }}
primary = {{ chrome.active }}
disabled = {{ ui.text_dim }}
alert = {{ ui.urgent }}
alert-foreground = {{ chrome.text }}
