{#
tmux's colors, which its tmux.conf sources: the options the rest of the config
uses for its status line, tabs and pane borders.
#}
# Generated by `bedeck build`.
# tmux colors, sourced by tmux.conf. These are based on the standard terminal
# colors.

set -g @fg "{{ chrome.text | tmux }}"
set -g @bg "{{ ui.background | tmux }}"
set -g @accent "{{ chrome.active | tmux }}"
set -g @bell_fg "{{ ui.alert | tmux }}"
set -g @border_bg "{{ ui.background | tmux }}"
set -g @border_active "{{ ui.highlight | tmux }}"
set -g @border_inactive "{{ chrome.inactive_bright | tmux }}"
set -g @active_bg1 "{{ ui.highlight | tmux }}"
set -g @active_bg2 "{{ ui.bright_highlight | tmux }}"
set -g @inactive_bg1 "{{ chrome.inactive | tmux }}"
set -g @inactive_bg2 "{{ chrome.inactive_bright | tmux }}"
