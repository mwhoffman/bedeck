{#
eza's theme. The styles at the top are fixed text. The filenames and extensions
sections below them give each name and extension its icon. Only the glyph is
set, not the icon's color: eza then draws each icon in the color it gives the
file's name.
#}
{% macro escape(glyph) -%}
{% set code = glyph | ord -%}
{{ '\\u%04X' % code if code <= 65535 else '\\U%08X' % code }}
{%- endmacro %}
# eza's theme. This mostly keeps eza's defaults, which use ANSI colors (and so
# the terminal's gruvbox palette), with changes to match .dircolors, git and
# nvim. Filename colors set by LS_COLORS (from .dircolors) take precedence over
# this file, so file kinds like directories, symlinks and pipes live there.
#
# Anything left out keeps eza's default, and a style only replaces the fields
# it sets, e.g. setting just a foreground keeps eza's default bold/underline;
# so some styles below turn those off explicitly. Color names are ANSI colors
# where "Light" means the bright variant (e.g. LightRed is 91, bright red); hex
# colors are used for gruvbox colors without an ANSI equivalent. Invalid color
# names are silently ignored.

# Sizes are green, as in eza's defaults, but all one (non-bold) green rather
# than changing color and weight with magnitude. Users keep eza's (bold) yellow.
size:
  major: {foreground: Green, is_bold: false}
  minor: {foreground: Green, is_bold: false}
  number_byte: {foreground: Green, is_bold: false}
  number_kilo: {foreground: Green, is_bold: false}
  number_mega: {foreground: Green, is_bold: false}
  number_giga: {foreground: Green, is_bold: false}
  number_huge: {foreground: Green, is_bold: false}
  unit_byte: {foreground: Green, is_bold: false}
  unit_kilo: {foreground: Green, is_bold: false}
  unit_mega: {foreground: Green, is_bold: false}
  unit_giga: {foreground: Green, is_bold: false}
  unit_huge: {foreground: Green, is_bold: false}

# Match git status and nvim (gitsigns/neo-tree): orange for new and modified
# files, and red for deleted ones. New files are mostly untracked ones, which
# git status and neo-tree show in orange; eza doesn't distinguish them from
# newly staged files, which those show in green. Gruvbox's orange has no ANSI
# equivalent.
git:
  new: {foreground: "#fe8019"}
  modified: {foreground: "#fe8019"}
  renamed: {foreground: "#fe8019"}
  typechange: {foreground: "#fe8019"}
  deleted: {foreground: LightRed}

# Gruvbox's gray, e.g. for the dashes in permissions, and for dates and the @
# marking files with extended attributes (which are common on macOS).
punctuation: {foreground: "#928374"}
date: {foreground: "#928374"}
perms:
  attribute: {foreground: "#928374"}

# Files that eza categorizes by name or extension. Media and archives match
# .dircolors, which only covers some of the extensions eza knows about.
# Documents (e.g. pdf, docx, xlsx) match media files, as they're similarly
# binary. Source and crypto files (e.g. ssh keys, certificates and checksums)
# are left uncolored and "important" ones (e.g. Makefile, README) are just
# underlined. Compiled files (e.g. .o, .pyc) keep eza's default yellow.
file_type:
  image: {foreground: LightMagenta, is_bold: false}
  video: {foreground: LightMagenta, is_bold: false}
  music: {foreground: LightMagenta, is_bold: false}
  lossless: {foreground: LightMagenta, is_bold: false}
  compressed: {foreground: LightRed, is_bold: false}
  source: {foreground: Default, is_bold: false}
  crypto: {foreground: Default, is_bold: false}
  document: {foreground: LightMagenta, is_bold: false}
  build: {foreground: Default, is_bold: false, is_underline: true}

# Generated by `bedeck build`: edit the icons file and rebuild instead.
{% for section, entries in {'filenames': eza_filenames, 'extensions': icons.ext}.items() %}
{{ section }}:
{% for name, icon in entries.items() %}
  {{ name | tojson }}: {icon: {glyph: "{{ escape(icon.glyph) }}"}}
{% endfor %}
{% endfor %}
