{#
eza's theme. The styles at the top name ANSI colors, so the terminal's theme
decides what they look like. The rest are filled in with the palette. We also
define filename/extension icons, albeit only the glyph so that eza draws the
colors from the file names/types.
#}
# Generated by `bedeck build`.

file_type:
  image: {foreground: LightMagenta, is_bold: false}
  video: {foreground: LightMagenta, is_bold: false}
  music: {foreground: LightMagenta, is_bold: false}
  lossless: {foreground: LightMagenta, is_bold: false}
  compressed: {foreground: LightRed, is_bold: false}
  temp: {foreground: DarkGray, is_dimmed: false}
  source: {foreground: Default, is_bold: false}
  crypto: {foreground: Default, is_bold: false}
  document: {foreground: LightMagenta, is_bold: false}
  build: {foreground: Default, is_bold: false, is_underline: true}

size:
  major: {foreground: Green, is_bold: false}
  minor: {foreground: Green, is_bold: false}
  number_byte: {foreground: Green, is_bold: false}
  number_kilo: {foreground: Green, is_bold: false}
  number_mega: {foreground: Green, is_bold: false}
  number_giga: {foreground: Green, is_bold: false}
  number_huge: {foreground: Green, is_bold: false}
  unit_byte: {foreground: Green, is_bold: false}
  unit_kilo: {foreground: Green, is_bold: false}
  unit_mega: {foreground: Green, is_bold: false}
  unit_giga: {foreground: Green, is_bold: false}
  unit_huge: {foreground: Green, is_bold: false}

git:
  new: {foreground: "{{ palette.bright_accent1 }}"}
  modified: {foreground: "{{ palette.bright_accent1 }}"}
  renamed: {foreground: "{{ palette.bright_accent1 }}"}
  typechange: {foreground: "{{ palette.bright_accent1 }}"}
  deleted: {foreground: LightRed}

punctuation: {foreground: "{{ palette.overlay1 }}"}
date: {foreground: "{{ palette.overlay1 }}"}
perms:
  attribute: {foreground: "{{ palette.overlay1 }}"}

{% macro escape(glyph) -%}
{% set code = glyph | ord -%}
{{ '\\u%04X' % code if code <= 65535 else '\\U%08X' % code }}
{%- endmacro %}
{% for section, entries in {'filenames': eza_filenames, 'extensions': icons.ext}.items() %}
{{ section }}:
{% for name, icon in entries.items() %}
  {{ name | tojson }}: {icon: {glyph: "{{ escape(icon.glyph) }}"}}
{% endfor %}
{% endfor %}
