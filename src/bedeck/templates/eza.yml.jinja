{#
eza's theme. The styles at the top name ANSI colors, so the terminal's theme
decides what they look like. The rest are filled in from the theme. We also
define filename/extension icons, albeit only the glyph so that eza draws the
colors from the file names/types.
#}
# Generated by `bedeck build`.

file_type:
  image: {foreground: {{ file.media | eza }}, is_bold: false}
  video: {foreground: {{ file.media | eza }}, is_bold: false}
  music: {foreground: {{ file.media | eza }}, is_bold: false}
  lossless: {foreground: {{ file.media | eza }}, is_bold: false}
  compressed: {foreground: {{ file.archive | eza }}, is_bold: false}
  temp: {foreground: {{ file.temp | eza }}, is_dimmed: false}
  source: {foreground: Default, is_bold: false}
  crypto: {foreground: Default, is_bold: false}
  document: {foreground: {{ file.document | eza }}, is_bold: false}
  build: {foreground: Default, is_bold: false, is_underline: true}

size:
  major: {foreground: {{ colors.green | eza }}, is_bold: false}
  minor: {foreground: {{ colors.green | eza }}, is_bold: false}
  number_byte: {foreground: {{ colors.green | eza }}, is_bold: false}
  number_kilo: {foreground: {{ colors.green | eza }}, is_bold: false}
  number_mega: {foreground: {{ colors.green | eza }}, is_bold: false}
  number_giga: {foreground: {{ colors.green | eza }}, is_bold: false}
  number_huge: {foreground: {{ colors.green | eza }}, is_bold: false}
  unit_byte: {foreground: {{ colors.green | eza }}, is_bold: false}
  unit_kilo: {foreground: {{ colors.green | eza }}, is_bold: false}
  unit_mega: {foreground: {{ colors.green | eza }}, is_bold: false}
  unit_giga: {foreground: {{ colors.green | eza }}, is_bold: false}
  unit_huge: {foreground: {{ colors.green | eza }}, is_bold: false}

git:
  new: {foreground: {{ git.added | eza }}}
  modified: {foreground: {{ git.modified | eza }}}
  renamed: {foreground: {{ git.modified | eza }}}
  typechange: {foreground: {{ git.modified | eza }}}
  deleted: {foreground: {{ git.deleted | eza }}}

punctuation: {foreground: {{ ui.text_faint | eza }}}
date: {foreground: {{ ui.text_faint | eza }}}
perms:
  attribute: {foreground: {{ ui.text_faint | eza }}}

{% macro escape(glyph) -%}
{% set code = glyph | ord -%}
{{ '\\u%04X' % code if code <= 65535 else '\\U%08X' % code }}
{%- endmacro %}
{% for section, entries in {'filenames': eza_filenames, 'extensions': icons.ext}.items() %}
{{ section }}:
{% for name, icon in entries.items() %}
  {{ name | tojson }}: {icon: {glyph: "{{ escape(icon.glyph) }}"}}
{% endfor %}
{% endfor %}
