{# 
The filenames and extensions sections of an eza theme, which give each name and
extension its icon. Only the glyph is set, not the icon's color: eza then draws
each icon in the color it gives the file's name.
#}
{% macro escape(glyph) -%}
{% set code = glyph | ord -%}
{{ '\\u%04X' % code if code <= 65535 else '\\U%08X' % code }}
{%- endmacro %}
# Generated by `bedeck build`: edit the icons file and rebuild instead.
{% for section, entries in {'filenames': eza_filenames, 'extensions': icons.ext}.items() %}
{{ section }}:
{% for name, icon in entries.items() %}
  {{ name | tojson }}: {icon: {glyph: "{{ escape(icon.glyph) }}"}}
{% endfor %}
{% endfor %}
