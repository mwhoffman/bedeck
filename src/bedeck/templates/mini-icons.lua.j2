{# A Lua module returning mini.icons' config, the colors of its highlight groups
   and the defaults. #}
{# The highlight group for a color, e.g. IconsVimGreen for vim-green. #}
{% macro highlight(color) %}Icons{{ color.title().replace('-', '') }}{% endmacro %}
{% macro lua(icon) -%}
{glyph = '\u{{ '{%x}' % (icon.glyph | ord) }}', hl = '{{ highlight(icon.color) }}'}
{%- endmacro %}
-- Generated by `bedeck build`: edit the icons file and rebuild instead.
return {
  -- The colors of the highlight groups the icons use.
  highlights = {
{% for name, hex in icon_colors.items() %}
    {{ highlight(name) }} = '{{ hex }}',
{% endfor %}
  },
  -- Icons for files with an extension nothing knows (file), files with
  -- no extension (noext) and directories (dir).
  defaults = {
{% for name in ['file', 'noext', 'dir'] %}
    {{ name }} = {{ lua(icons.default[name]) }},
{% endfor %}
  },
  -- mini.icons' defaults, by category (it has no default for files
  -- with no extension).
  default = {
    directory = {{ lua(icons.default.dir) }},
    extension = {{ lua(icons.default.file) }},
    file = {{ lua(icons.default.file) }},
    filetype = {{ lua(icons.default.file) }},
  },
{# mini.icons' categories, and the section of the icons file each one is. #}
{% for category, section in {'directory': 'dir', 'file': 'file', 'extension': 'ext', 'filetype': 'filetype'}.items() %}
  {{ category }} = {
{% for name, icon in icons[section].items() %}
    [{{ name | lua_string }}] = {{ lua(icon) }},
{% endfor %}
  },
{% endfor %}
}
