{#
The colors of kitty's tab bar, which tab_bar.py (in kitty's config directory)
draws and reads these from.
#}
# Generated by `bedeck build`.
# Colors for the tab bar drawn by tab_bar.py.

# The index (color1) and title (color2) sections of the active tab.
active_color1 {{ chrome.active }}
active_color2 {{ chrome.active_bright }}

# The index and title sections of inactive tabs.
inactive_color1 {{ chrome.inactive }}
inactive_color2 {{ chrome.inactive_bright }}

# The tab text and the bell shown on inactive tabs needing attention.
text_color {{ chrome.text }}
bell_color {{ ui.alert }}
