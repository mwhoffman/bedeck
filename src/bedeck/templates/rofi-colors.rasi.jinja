{#
rofi's colors, which its theme imports: each is named for what the theme uses
it for.
#}
/* Generated by `bedeck build`. */
/* rofi colors, imported by theme.rasi. */

* {
  bg: {{ ui.background }};
  fg: {{ ui.text }};
  accent: {{ chrome.active }};    /* The search bar. */
  outline: {{ chrome.active }};   /* The border around the window. */
  selected: {{ ui.selection }};  /* The selected row. */
}
