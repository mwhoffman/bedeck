{#
rofi's colors, which its theme imports: each is named for what the theme uses
it for.
#}
/* Generated by `bedeck build`. */
/* rofi colors, imported by theme.rasi. */

* {
  bg: {{ palette.base }};
  fg: {{ palette.text }};
  accent: {{ palette.blue }};    /* The search bar. */
  outline: {{ palette.blue }};   /* The border around the window. */
  selected: {{ palette.text }};  /* The selected row. */
}
