{#
i3's colors, which its config includes: the colors as variables, and the client
(window border) colors which use them.
#}
# Generated by `bedeck build`.
# i3 colors, included by the config. The client colors are set here rather than
# in the config, since variables set in an included file can't be used by the
# file which includes it.

set $bg {{ palette.base }}
set $fg {{ palette.text }}
set $red {{ palette.red }}
set $green {{ palette.green }}
set $yellow {{ palette.yellow }}
set $blue {{ palette.blue }}
set $blue2 {{ palette.bright_blue }}
set $purple {{ palette.magenta }}
set $gray {{ palette.overlay2 }}
set $darkgray {{ palette.mantle }}

client.focused $blue2 $blue $fg $purple $blue
client.focused_inactive $darkgray $darkgray $gray $purple $darkgray
client.unfocused $darkgray $darkgray $gray $purple $darkgray
client.urgent $red $red $fg $red $red
