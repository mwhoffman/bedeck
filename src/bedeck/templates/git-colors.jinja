{#
git's colors, which its config includes.
#}
# Generated by `bedeck build`.
# git colors, included by config.

# Colors for git status: green for staged changes, yellow for unstaged ones
# (which eza's theme matches) and red for untracked files.
[color "status"]
    added = {{ git.added | git }}
    changed = {{ git.modified | git }}
    untracked = {{ git.untracked | git }}
