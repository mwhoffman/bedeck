{#
The colors GNU ls (and eza) give files by their kind and extension: dircolors
turns this into LS_COLORS.
#}
{% set archive = file.archive | sgr %}
{% set media = file.media | sgr %}
{% set document = file.document | sgr %}
{% set compiled = file.compiled | sgr %}
{% set temp = file.temp | sgr %}
# Generated by `bedeck build`.

# Configuration file for dircolors, a utility to help you set the
# LS_COLORS environment variable used by GNU ls with the --color option.

# The following TERM entries are used to match against the TERM environment
# variable to determine if it is colorizable.
COLORTERM ?*
TERM Eterm
TERM ansi
TERM *color*
TERM *direct*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM dtterm
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM terminator
TERM tmux*
TERM vt100
TERM xterm*

# We mostly use the bright variants (90-97 for text, 100-107 for backgrounds)
# Directories are the exception: they use the darker blue (#458588).

RESET                  0         # reset to normal color
DIR                    01;{{ file.directory | sgr }}     # directory
LINK                   {{ file.symlink | sgr }}        # symlink. "target" uses the linked color.
FIFO                   04;{{ file.special | sgr }}     # pipe
SOCK                   04;{{ file.special | sgr }}     # socket
DOOR                   04;{{ file.special | sgr }}     # door
BLK                    04;{{ file.special | sgr }}     # block device driver
CHR                    04;{{ file.special | sgr }}     # character device driver
ORPHAN                 09;{{ file.symlink | sgr }}     # orphaned symlink
MISSING                09;{{ file.special | sgr }}     # ... and the files they point to
SETUID                 {{ colors.black | sgr }};{{ colors.bright_red | sgr('bg') }}    # file that is setuid (u+s)
SETGID                 {{ colors.black | sgr }};{{ colors.bright_yellow | sgr('bg') }}    # file that is setgid (g+s)
CAPABILITY             00        # file with capability (off: slow to check)
EXEC                   01;{{ file.executable | sgr }}     # file with execute permission
STICKY_OTHER_WRITABLE  {{ colors.black | sgr }};{{ colors.bright_green | sgr('bg') }}    # dir that is sticky and other-writable
OTHER_WRITABLE         {{ colors.black | sgr }};{{ colors.bright_yellow | sgr('bg') }}    # dir that is other-writable and not sticky
STICKY                 {{ colors.black | sgr }};{{ colors.bright_blue | sgr('bg') }}    # dir that is sticky and not other-writable

