{#
dunst's config: the colors of its notifications, with a line between them and no
icons. Like rofi's window, a notification has the background color with a
colored border, which shows its urgency. Everything else keeps dunst's defaults.
#}
# Generated by `bedeck build`.

[global]
# Don't show icons.
icon_position = off
separator_color = frame
frame_color = "{{ palette.blue }}"
highlight = "{{ palette.bright_blue }}"
origin = bottom-right
offset = 10x50

# Low urgency is dimmed, like polybar's disabled items.
[urgency_low]
background = "{{ palette.base }}"
foreground = "{{ palette.overlay2 }}"

# Normal urgency has the accent border, like rofi and i3's focused window.
[urgency_normal]
background = "{{ palette.base }}"
foreground = "{{ palette.text }}"

# Critical urgency has a yellow border.
[urgency_critical]
background = "{{ palette.base }}"
foreground = "{{ palette.text }}"
frame_color = "{{ palette.bright_yellow }}"
highlight = "{{ palette.bright_yellow }}"
