{#
A Lua module for nvim, bedeck.icons, whose setup() sets up mini.icons with the
icons and defines the highlight groups they use. It also has the default icons,
since mini.icons has none for files with no extension.
#}
{% macro highlight(color) %}Icons{{ color.title().replace('_', '').replace('.', '') }}{% endmacro %}
{% macro lua(icon) -%}
{glyph = '\u{{ '{%x}' % (icon.glyph | ord) }}', hl = '{{ highlight(icon.color) }}'}
{%- endmacro %}
-- Generated by `bedeck build`.
local M = {}

-- The colors of the highlight groups the icons use.
local highlights = {
{% for name, hex in icon_colors.items() %}
  {{ highlight(name) }} = '{{ hex }}',
{% endfor %}
}

-- Icons for files with an extension nothing knows (file), files with no
-- extension (noext) and directories (dir).
M.defaults = {
{% for name in ['file', 'noext', 'dir'] %}
  {{ name }} = {{ lua(icons.default[name]) }},
{% endfor %}
}

-- mini.icons' config.
local config = {
  -- Its defaults, by category (it has no default for files with no
  -- extension).
  default = {
    directory = {{ lua(icons.default.dir) }},
    extension = {{ lua(icons.default.file) }},
    file = {{ lua(icons.default.file) }},
    filetype = {{ lua(icons.default.file) }},
  },
{# mini.icons' categories, and the section of the icons file each one is. #}
{% for category, section in {'directory': 'dir', 'file': 'file', 'extension': 'ext', 'filetype': 'filetype'}.items() %}
  {{ category }} = {
{% for name, icon in icons[section].items() %}
    [{{ name | lua_string }}] = {{ lua(icon) }},
{% endfor %}
  },
{% endfor %}
}

-- Set up mini.icons with the icons, and define their highlight groups.
function M.setup()
  -- The colorscheme clears the groups when it changes, so define them again
  -- whenever it does.
  local function set_highlights()
    for group, color in pairs(highlights) do
      vim.api.nvim_set_hl(0, group, {fg = color})
    end
  end
  set_highlights()
  vim.api.nvim_create_autocmd("ColorScheme", {
    group = vim.api.nvim_create_augroup("bedeck_icons", {clear = true}),
    callback = set_highlights,
  })

  local mini = require("mini.icons")
  mini.setup(config)

  -- mini.icons uses a letter (the Nerd Font glyphs md-alpha_a to md-alpha_z) as
  -- the icon of each filetype it has no real icon for, e.g. a D for dircolors.
  -- Give those we have no icon for either our default one instead.
  -- TODO: look into a better way to do this.
  for _, name in ipairs(mini.list("filetype")) do
    local code = vim.fn.char2nr((mini.get("filetype", name)))
    if config.filetype[name] == nil and code >= 0xf0aee and code <= 0xf0b07 then
      config.filetype[name] = config.default.filetype
    end
  end
  mini.setup(config)
end

return M
